#!/usr/bin/env bash
# YouTube TUI: Terminal YouTube client reproducing YouTube web with Yazi styling,
# multi-type search (videos, channels, playlists), Chafa true-color thumbnails,
# and smart deduplicating MPV streaming.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Ensure youtubetui package is in PYTHONPATH
export PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}"

# Legacy fallback if explicitly requested
if [[ "${1:-}" == "--legacy" ]]; then
    shift
    export YTFZF_PREF="bestvideo[vcodec^=vp9]+bestaudio/bestvideo+bestaudio/best"
    exec ytfzf --show-thumbnails "$@"
fi

exec python3 -m youtubetui.app "$@"
